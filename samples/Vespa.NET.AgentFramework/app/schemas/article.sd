schema article {
    document article {
        field title type string {
            indexing: summary | index
        }
        field category type string {
            indexing: attribute | summary
            attribute: fast-search
            rank: filter
            match: cased
        }
        field priority type int {
            indexing: attribute | summary
        }
        field published type bool {
            indexing: attribute | summary
        }
        field embedding type tensor<float>(x[768]) {
            indexing: attribute | index | summary
            attribute {
                distance-metric: angular
            }
        }
    }
    document-summary vector_data {
        from-disk
        summary documentid {}
        summary title {}
        summary category {}
        summary priority {}
        summary published {}
    }
    rank-profile vector_search {
        inputs {
            query(query_embedding) tensor<float>(x[768])
        }
        first-phase {
            expression: closeness(field, embedding)
        }
        match-features: distance(field, embedding)
    }
}
