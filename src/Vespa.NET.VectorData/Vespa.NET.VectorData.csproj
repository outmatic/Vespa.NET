<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Vespa.NET.VectorData</PackageId>
    <Version>2.0.0</Version>
    <RootNamespace>Vespa.VectorData</RootNamespace>
    <Description>Microsoft.Extensions.VectorData provider for existing Vespa application schemas, with typed and dynamic records, dense vector and keyword hybrid search, and Microsoft Agent Framework semantic-memory support.</Description>
    <PackageReleaseNotes>Breaking: collection existence and listing require an authoritative catalog; ensure requires a catalog or explicit AssumeSchemaExists. Adds keyword hybrid search, six vector metrics, multiple vector fields, numeric keys, nullable and generated embeddings, dates, lists, membership filters and ordering. Uses unranked for filtered reads and probes, independent hybrid candidate budgets and conservative server-side dot-product thresholds. Schema deployment remains external. See the package README and changelog for migration guidance.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <ProjectReference Include="../Vespa.NET/Vespa.NET.csproj" />
    <None Update="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" Pack="false" />
    <None Remove="README.md" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
