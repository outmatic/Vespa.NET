<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Vespa.NET.VectorData</PackageId>
    <Version>1.0.0</Version>
    <RootNamespace>Vespa.VectorData</RootNamespace>
    <Description>Microsoft.Extensions.VectorData provider for existing Vespa application schemas, with typed records and cosine vector search.</Description>
    <PackageReleaseNotes>Initial release with typed record operations, cosine vector search, scalar filters, text queries through a caller-provided embedding generator, and Microsoft Agent Framework examples for retrieval and persistent user preferences. Requires an existing Vespa application schema.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <ProjectReference Include="../Vespa.NET/Vespa.NET.csproj" />
    <None Update="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" Pack="false" />
    <None Remove="README.md" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
