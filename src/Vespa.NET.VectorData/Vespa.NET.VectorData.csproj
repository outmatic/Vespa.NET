<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Vespa.NET.VectorData</PackageId>
    <Version>1.2.0</Version>
    <RootNamespace>Vespa.VectorData</RootNamespace>
    <Description>Microsoft.Extensions.VectorData provider for existing Vespa application schemas, with typed and dynamic records, cosine vector search, and Microsoft Agent Framework chat-history memory support.</Description>
    <PackageReleaseNotes>Adds collection-specific options and optional summary selection while retaining backend defaults. Validates requested vectors and required data, assigns requested vectors once, projects document reads, and adds bounded upsert and embedding batches with concurrent ordered writes and explicit partial outcomes. Adds configurable HNSW exploration and deployment guidance.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <ProjectReference Include="../Vespa.NET/Vespa.NET.csproj" />
    <None Update="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" Pack="false" />
    <None Remove="README.md" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
