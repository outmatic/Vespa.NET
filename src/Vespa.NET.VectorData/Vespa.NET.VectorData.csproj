<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Vespa.NET.VectorData</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <RootNamespace>Vespa.VectorData</RootNamespace>
    <Description>Experimental Microsoft.Extensions.VectorData provider for existing Vespa application schemas.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <ProjectReference Include="../Vespa.NET/Vespa.NET.csproj" />
    <None Update="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" Pack="false" />
    <None Remove="README.md" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
