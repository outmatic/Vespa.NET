<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>Vespa.NET.Models</PackageId>
    <RootNamespace>Vespa.Models</RootNamespace>
    <AssemblyName>Vespa.NET.Models</AssemblyName>
    <Description>DTOs, attributes, and tensor types for Vespa.NET — the high-performance .NET client for Vespa.ai.</Description>
    <PackageTags>vespa;vespa.ai;search;vector-search;rag;ai;embedding</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The schema builder shares runtime rank profile definitions with package options. -->
    <InternalsVisibleTo Include="Vespa.NET" />
    <InternalsVisibleTo Include="Vespa.NET.AgentFramework" />
    <InternalsVisibleTo Include="Vespa.NET.VectorData" />
    <InternalsVisibleTo Include="Vespa.NET.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
  </ItemGroup>

</Project>
